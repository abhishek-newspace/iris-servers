# ============= KEYCLOAK CONFIGURATION =============
# 💡 Points securely to Keycloak via the Nginx /auth/ proxy route
VITE_KEYCLOAK_URL=https://10.10.60.250/auth
VITE_KEYCLOAK_REALM=iris
VITE_KEYCLOAK_CLIENT_ID=iris-frontend

# ============= BACKEND API CONFIGURATION =============
# 💡 Points to your FastAPI backend via the Nginx /api/v1/ proxy route
VITE_BACKEND_URL=https://10.10.60.250/api/v1

# ============= FRONTEND APP CONFIGURATION =============
# 💡 The base landing URL for the frontend app on standard secure HTTPS
VITE_APP_NAME=Iris Application
VITE_APP_BASE_URL=https://10.10.60.250  

# ============= OPTIONAL =============
VITE_ENABLE_DEBUG=false