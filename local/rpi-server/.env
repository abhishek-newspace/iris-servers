# MQTT Broker
# BROKER_URL=20.197.4.44
BROKER_URL=10.10.60.225
BROKER_PORT=8883
KEEPALIVE=60

# Paths
VERSION_FILE=/app/db/data.json

# App
CONTAINER_NAME=robot_client
SERIAL_NUMBER=e5a92ea5a2bfe793
DEVICE_TYPE=local_window
# SERIAL_NUMBER=1420625030528
MODEL_MAKE = "Alfred v1"
YEAR = "2025"

# mTLS Certificate Paths
MQTT_ROOT_CA=/app/certs/rootCA.crt.pem          # For verification
MQTT_INTERMEDIATE_CA=/app/certs/intermediateCA.crt.pem  # To send in handshake
MQTT_TLS_ENABLED=true
PKI_API_KEY=backend-secret-key
PKI_ROOT_CA=/app/certs/rootCA.crt.pem
ROBOT_ID=e5a92ea5a2bfe793
PKI_SERVER_URL=http://10.10.60.90:9000
CERT_RENEWAL_THRESHOLD=300                           # sec
CERT_CHECK_INTERVAL=20                              # sec
PKI_RENEWAL_ENDPOINT=https://10.10.60.90:9000/api/v1/renew-certificate
